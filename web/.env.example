# คัดลอกค่าจาก /root/iks-web/db.env บน VPS (สคริปต์ deploy ทำให้อัตโนมัติ)
DATABASE_URL_PUBLIC=postgres://iks_web_public:CHANGE_ME@127.0.0.1:5433/iks_web
DATABASE_URL_ADMIN=postgres://iks_web_admin:CHANGE_ME@127.0.0.1:5433/iks_web
MEDIA_PUBLIC_URL=/media

# เปิดดูเว็บพร้อมข้อมูลตัวอย่าง: https://ikssa.io/preview?token=<PREVIEW_TOKEN>
PREVIEW_TOKEN=CHANGE_ME

# prelaunch = คนทั่วไปเห็นหน้า "เร็วๆ นี้" (ยกเว้นโหมดพรีวิว) / live = เปิดเว็บจริง
SITE_MODE=prelaunch
